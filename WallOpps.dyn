      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef getRequiredWallType(wallTypes) :\r\n    \r\n    for wallType in wallTypes :\r\n        \r\n        wallTypeName = wallType.Name \r\n        \r\n        if \"Generic\" in wallTypeName :\r\n            \r\n            return UnwrapElement(wallType)\r\n    \r\n    return None\r\n    \r\ndef duplicateWalls(document, thickness, wallTypeRequired) :\r\n    \r\n    duplicatedWallTypes = []\r\n    \r\n    TransactionManager.Instance.EnsureInTransaction(document)\r\n    \r\n    for width in thickness :\r\n        \r\n        width =  UnitUtils.ConvertToInternalUnits(width, UnitTypeId.Feet)\r\n\r\n        newWallType = wallTypeRequired.Duplicate(\"Basic Wall \" + str(width))\r\n\r\n        compoundStructure = wallTypeRequired.GetCompoundStructure()\r\n        coreLayer = compoundStructure.GetFirstCoreLayerIndex()\r\n\r\n        compoundStructure.SetLayerWidth(coreLayer, width)\r\n        \r\n        newWallType.SetCompoundStructure(compoundStructure)\r\n        \r\n        duplicatedWallTypes.append(newWallType)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n    \r\n    return duplicatedWallTypes\r\n\r\ndocument = DocumentManager.Instance.CurrentDBDocument\r\n\r\nwallTypes        = IN[0]\r\ndeserializedData = IN[1]\r\n\r\ntotalThickness = deserializedData[0]\r\nunconnectedHeights = deserializedData[1]\r\nlocationCurves = deserializedData[2]\r\nthickness = deserializedData[3]\r\n\r\nwallTypeRequired = getRequiredWallType(wallTypes)\r\n\r\nOUT = duplicateWalls(document, thickness, wallTypeRequired), thickness, totalThickness, unconnectedHeights, locationCurves\r\n\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "82334852b0cf4407a02a407fb354919d",
      "Inputs": [
        {
          "Id": "66f2b3399d7f431080e879ab0e755e19",
