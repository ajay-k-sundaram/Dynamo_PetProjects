    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import json\r\nimport clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\ndef processLocationCurves(start, end) :\r\n\r\n    startXYZ = XYZ(float(start[\"X\"]), float(start[\"Y\"]), float(start[\"Z\"]))\r\n    endXYZ   = XYZ(float(end[\"X\"]), float(end[\"Y\"]), float(end[\"Z\"]))\r\n    \r\n    line     = Line.CreateBound(startXYZ, endXYZ)\r\n\r\n    return line\r\n\r\nfile_path = \"C:\\\\Users\\\\Public\\\\Documents\\\\WallData.json\"\r\n\r\nwith open(file_path, 'r') as file:\r\n    data = json.load(file)\r\n    \r\n\r\ntotalThickness = []\r\nunconnectedHeights = []\r\nlocationCurves = []\r\n\r\nfor item in data :\r\n    \r\n    thickness = float(item[\"Thickness\"])\r\n    totalThickness.append(round(thickness, 1))\r\n    \r\n    start     = item[\"Start\"]\r\n    end       = item[\"End\"]\r\n    \r\n    locationCurve = processLocationCurves(start, end)\r\n    locationCurves.append(locationCurve)\r\n    \r\n    height    = item[\"Height\"]\r\n    unconnectedHeights.append(float(height))\r\n    \r\nOUT = totalThickness, unconnectedHeights, locationCurves, list(set(totalThickness))",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0706dca549a84fd6b4934c709bdd618c",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "f1ba84a966db4e7c9b99bce5b34135b8",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef createWalls(document, wallTypes, thickness, totalThickness, unconnectedHeights, locationCurves, level) :\r\n\r\n    walls = []\r\n    \r\n    TransactionManager.Instance.EnsureInTransaction(document)\r\n    \r\n    for iterator in range(len(totalThickness)) :\r\n        \r\n        height = unconnectedHeights[iterator]\r\n        height = UnitUtils.ConvertToInternalUnits(height, UnitTypeId.Feet)\r\n        \r\n        locationCurve = locationCurves[iterator]\r\n        \r\n        width = totalThickness[iterator]\r\n        requiredIndex = thickness.index(width)\r\n        \r\n        wallType = UnwrapElement(wallTypes[requiredIndex])\r\n        \r\n        wall = Wall.Create(document, locationCurve, wallType.Id, level.Id, height, 0.0, False, False)\r\n        # parameter = wall.LookupParameter(\"Unconnected Height\")\r\n        \r\n        walls.append(wall)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n        \r\nwallData = IN[0]\r\n\r\nwallTypes = wallData[0]\r\nthickness = wallData[1]\r\ntotalThickness = wallData[2]\r\nunconnectedHeights = wallData[3]\r\nlocationCurves = wallData[4]\r\n\r\ndocument = DocumentManager.Instance.CurrentDBDocument\r\nlevel = FilteredElementCollector(document).OfClass(Level).FirstElement()\r\n\r\nOUT = createWalls(document, wallTypes, thickness, totalThickness, unconnectedHeights, locationCurves, level)",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "92d4d1af461b48969bc23b9881dd04fe",
