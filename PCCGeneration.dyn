      "Description": "Get all the elements which are visible in the active view."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import traceback\r\n\r\nimport System\r\nfrom System.Collections.Generic import List\r\n\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclass CreatePCC :\r\n\r\n\t__listOfCurves = None\r\n\t__floorTypeId = None\r\n\t__levelId = None\r\n\t__document = None\r\n\t\r\n\tdef __init__(self, curves, floorType, level, document) :\r\n\t\t\r\n\t\tself.__listOfCurves = self.filterEmptyList(curves)\r\n\t\tself.__floorTypeId = floorType.Id\r\n\t\tself.__levelId = level.Id\r\n\t\tself.__document = document\r\n\t\t\r\n\tdef filterEmptyList(self, curves) :\r\n\t\t\r\n\t\tcurveLoops = CurveLoop()\r\n\r\n\t\tfor iterator in range(len(curves)) :\r\n\r\n\t\t\tcurveLoops.Append(curves[iterator]) #  .ToRevitType()\r\n\t\t\t\r\n\t\treturn curveLoops\r\n\t\t\r\n\tdef createPCC(self) :\r\n\t\t\r\n\t\r\n\t\tcurveLoops = List[CurveLoop]()\r\n\t\tcurveLoops.Add(self.__listOfCurves)\r\n\r\n\t\tTransactionManager.Instance.EnsureInTransaction(document)\r\n\t\t\r\n\t\tfloor = Floor.Create(self.__document, curveLoops, ElementId(self.__floorTypeId), self.__levelId)\r\n\t\t\r\n\t\tTransactionManager.Instance.TransactionTaskDone()\r\n\t\t\r\n\t\treturn floor\r\n\t\t\r\n\r\ndef getLevel(element) :\r\n\t\r\n\tif hasattr(element, \"LevelId\") : return element.Document.GetElement(element.LevelId)\r\n\telif hasattr(element, \"Level\") : return element.Level\r\n\r\ndef getBuiltInCategory(categoryId) :\r\n\t\r\n\treturn System.Enum.ToObject(BuiltInCategory, categoryId.IntegerValue)\r\n\r\ndef getSolids(element) : return element.Geometry()\r\n\r\ndef getAllSurface(solids) :\r\n\t\r\n\tallSurfaces = []\r\n\t\r\n\tfor solid in solids :\r\n\t\t\r\n\t\tsurfaces = solid.Explode()\r\n\t\tallSurfaces.extend(surfaces)\r\n\t\t\r\n\treturn allSurfaces\r\n\r\ndef getRequiredFace(surfaces) :\r\n\t\r\n\tpointSurfaceDictionary = {}\r\n\tfor surface in surfaces :\r\n\t\t\r\n\t\tpoint = surface.PointAtParameter(0.5,0.5)\r\n\t\tz = point.Z\r\n\t\tpointSurfaceDictionary[z] = surface\r\n\r\n\tminimum = min(pointSurfaceDictionary)\r\n\t\r\n\treturn pointSurfaceDictionary[minimum], minimum\r\n\t\r\ndef toRevitType(curves) :\r\n\trevitCurves = []\r\n\t\r\n\tfor curve in curves :\r\n\t\t\r\n\t\trevitCurves.append(curve.ToRevitType())\r\n\t\r\n\treturn revitCurves\r\n\t\t\r\n\r\ndef getRequiredBoundryCurves(element) :\r\n\t\r\n\tsolids = getSolids(element)\r\n\r\n\tif solids :\r\n\r\n\t\tsurfaces = getAllSurface(solids)\r\n\r\n\t\trequiredFace, z = getRequiredFace(surfaces)\r\n\t\r\n\t\tperimeterCurves = requiredFace.PerimeterCurves()\r\n\t\r\n\t\trevitCurves = toRevitType(perimeterCurves)\r\n\r\n\t\treturn revitCurves, z\r\n\t\r\n\treturn None, None\r\n\r\ndef setParameter(element, parameterName, value) :\r\n\t\r\n\ttry :\r\n\r\n\t\telement.SetParameterByName(parameterName, value)\r\n\t\treturn \"Success\"\r\n\r\n\texcept : return traceback.format_exc()\r\n\r\nallElements = IN[0]\r\nfloorType = IN[1]\r\nheightParameterName = IN[2]\r\n\r\nOUT = []\r\n\r\nrevitElements = UnwrapElement(allElements)\r\ndocument = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\nfor iterator in range(len(revitElements)) :\r\n\t\r\n\trevitElement = revitElements[iterator]\r\n\tprotoElement = allElements[iterator]\r\n\t\r\n\tif hasattr(revitElement, \"Category\") :\r\n\t\t\r\n\t\tcategory = revitElement.Category \r\n\t\t\r\n\t\tif category :\r\n\t\t\t\r\n\t\t\tcategoryId = category.Id\r\n\t\t\t\r\n\t\t\tbuiltInCategory = getBuiltInCategory(categoryId)\r\n\t\t\t\r\n\t\t\tif builtInCategory == BuiltInCategory.OST_StructuralFoundation :\r\n\t\t\t\t\r\n\t\t\t\tlevel = getLevel(revitElement)\r\n\t\t\t\t\r\n\t\t\t\tif level :\r\n\t\t\t\t\t\r\n\t\t\t\t\televation = level.ToDSType(True).Elevation\r\n\t\t\t\t\t\r\n\t\t\t\t\tobjectType = revitElement.GetType().ToString()\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\trevitCurves, z = getRequiredBoundryCurves(protoElement)\r\n\t\t\t\t\t\r\n\t\t\t\t\tif revitCurves :\r\n\t\t\t\t\t\r\n\t\t\t\t\t\tcreatePCC = CreatePCC(revitCurves, floorType, level, document)\r\n\t\t\t\t\t\tpcc = createPCC.createPCC()\r\n\t\t\t\t\t\tprotoPCC = pcc.ToDSType(True)\r\n\r\n\t\t\t\t\t\tvalue = z - elevation\r\n\r\n\t\t\t\t\t\ttask = setParameter(protoPCC, heightParameterName, value)\r\n\t\t\t\t\t\tOUT.append([task, protoElement])\r\n\t\t\t\t\t\t\r\n\t\t\t\t\telse : \r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tOUT.append([\"Unidentified Element\", protoElement])\r\n\t\t\t\t\r\n\r\n",
      "Engine": "IronPython2",
